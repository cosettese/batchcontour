----
import {
  "moonbitlang/async@0.22.10/shell",
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
}
----

///|
async fn moon(args : Array[String]) -> Unit {
  @shell.Cmd("moon", args, stdout=Inherit, stderr=Inherit).run(
    timeout_ms=180000,
  )
}

///|
async fn invoke_cli(
  target : String,
  arguments : Array[String],
  code : Int32,
) -> (String, String) {
  let result = @shell.Cmd(
    "moon",
    ["run", "cmd/batchcontour", "--target", target, "--", ..arguments],
  ).output()
  if result.exit_code() != code {
    fail(
      "unexpected exit for \{target}/\{arguments.join(" ")}: \{result.exit_code()}\n\{result.stdout()}\n\{result.stderr()}",
    )
  }
  (result.stdout().trim().to_owned(), result.stderr())
}

///|
async fn demo(
  target : String,
  example : String,
  code : Int32,
) -> (String, String) {
  invoke_cli(
    target,
    ["review", "examples/kubernetes/" + example + ".json"],
    code,
  )
}

///|
async fn verify_duration_cli(target : String) -> (String, String, String) {
  let plan = "examples/kubernetes/maintenance.json"
  let (blocked, _) = invoke_cli(
    target,
    ["verify-durations", plan, "examples/kubernetes/runtime-outlier.json"],
    2,
  )
  let report = @json.parse(blocked[:])
  guard report is Object(fields) &&
    fields.get("verdict") == Some(Json::string("blocked")) &&
    fields.get("checks") is Some(Array([Object(_), Object(candidate)])) &&
    candidate.get("observed_maximum_seconds") == Some(Json::number(143.0)) &&
    candidate.get("violations") is Some(Array([Object(violation)])) &&
    violation.get("id") == Some(Json::string("can-2")) &&
    violation.get("reason") == Some(Json::string("above_maximum")) else {
    fail("incorrect duration evidence report on " + target)
  }
  let invalid_history = "examples/kubernetes/invalid.json"
  let (invalid, diagnostic) = invoke_cli(
    target,
    ["verify-durations", plan, invalid_history],
    1,
  )
  assert_eq(invalid, "")
  assert_true(diagnostic.contains(invalid_history))
  assert_true(diagnostic.contains("Duplicate key"))
  let (passed, _) = invoke_cli(
    target,
    ["verify-durations", plan, "examples/kubernetes/runtime-in-range.json"],
    0,
  )
  let report = @json.parse(passed[:])
  guard report is Object(fields) &&
    fields.get("verdict") == Some(Json::string("passed")) else {
    fail("incorrect duration pass report on " + target)
  }
  let (proposal, _) = invoke_cli(
    target,
    ["propose-durations", plan, "examples/kubernetes/runtime-outlier.json"],
    0,
  )
  let updated = @json.parse(proposal[:])
  guard updated is Object(fields) &&
    fields.get("schema") == Some(Json::string("batchcontour.input.v2")) &&
    fields.get("capacity_overrides") is Some(Array([Object(_)])) &&
    fields.get("baseline") is Some(Array([Object(base)])) &&
    fields.get("candidate") is Some(Array([Object(candidate)])) &&
    base.get("max_minutes") == Some(Json::number(2.0)) &&
    candidate.get("max_minutes") == Some(Json::number(3.0)) else {
    fail("incorrect proposed bounds on " + target)
  }
  println("Duration evidence verified on " + target)
  (blocked, passed, proposal)
}

///|
async fn verify_cli(target : String) -> Array[String] {
  let (before, _) = demo(target, "blocked", 2)
  let report = @json.parse(before[:])
  guard report is Object(fields) &&
    fields.get("verdict") == Some(Json::string("blocked")) &&
    fields.get("regression_count") == Some(Json::number(2.0)) &&
    fields.get("findings") is Some(Array([Object(first), Object(_)])) &&
    first.get("candidate") is Some(Object(load)) &&
    load.get("minimum") == Some(Json::number(3.0)) &&
    load.get("maximum") == Some(Json::number(4.0)) else {
    fail("incorrect blocked report on " + target)
  }
  let (invalid, diagnostic) = demo(target, "invalid", 1)
  assert_eq(invalid, "")
  assert_true(diagnostic.contains("Duplicate key"))
  let (after, _) = demo(target, "repaired", 0)
  let report = @json.parse(after[:])
  guard report is Object(fields) &&
    fields.get("verdict") == Some(Json::string("passed")) &&
    fields.get("findings") is Some(Array([])) else {
    fail("incorrect repaired report on " + target)
  }
  let (maintenance, _) = demo(target, "maintenance", 2)
  let report = @json.parse(maintenance[:])
  guard report is Object(fields) &&
    fields.get("regression_count") == Some(Json::number(2.0)) &&
    fields.get("findings") is Some(Array([Object(first), Object(second)])) &&
    first.get("window") ==
    Some({ "start": "2026-11-23T02:02:00Z", "end": "2026-11-23T02:03:00Z" }) &&
    second.get("window") ==
    Some({ "start": "2026-11-23T02:03:00Z", "end": "2026-11-23T02:04:00Z" }) &&
    first.get("capacity") == Some(Json::number(1.0)) &&
    second.get("capacity") == Some(Json::number(1.0)) else {
    fail("incorrect maintenance report on " + target)
  }
  println("CLI file workflow verified on " + target)
  let (existing, _) = demo(target, "existing-overload", 0)
  let (gate, _) = invoke_cli(
    target,
    [
      "gate", "examples/kubernetes/existing-overload.json", "examples/kubernetes/strict-policy.json",
    ],
    2,
  )
  let gate_json = @json.parse(gate[:])
  guard gate_json is Object(fields) &&
    fields.get("regression_blocked") == Some(Json::boolean(false)) &&
    fields.get("violations") is Some(Array([Object(violation)])) &&
    violation.get("metric") == Some(Json::string("possible_minutes")) &&
    violation.get("limit") == Some(Json::number(1.0)) &&
    violation.get("actual") == Some(Json::number(2.0)) else {
    fail("incorrect absolute policy gate on " + target)
  }
  let (summary, _) = invoke_cli(
    target,
    ["summarize", "examples/kubernetes/maintenance.json"],
    2,
  )
  let summary_json = @json.parse(summary[:])
  guard summary_json is Object(fields) &&
    fields.get("resources") is Some(Array([Object(resource)])) &&
    resource.get("regression_minutes") == Some(Json::number(2.0)) &&
    resource.get("candidate") is Some(Object(debt)) &&
    debt.get("maximum_excess_unit_minutes") == Some(Json::number(2.0)) else {
    fail("incorrect maintenance summary on " + target)
  }
  let (duration_blocked, duration_passed, proposal) = verify_duration_cli(
    target,
  )
  let evidence = verify_evidence_cli(target)
  let gate_evidence = verify_gate_evidence_cli(target)
  let (repair, _) = invoke_cli(
    target,
    [
      "repair", "examples/kubernetes/repair-input.json", "examples/kubernetes/repair-options.json",
    ],
    0,
  )
  let result = @json.parse(repair[:])
  guard result is Object(data) &&
    data.get("selected") == Some(Json::string("after-snapshot")) &&
    data.get("options") is Some(Array([Object(keep), Object(drop), Object(_)])) &&
    keep.get("verdict") == Some(Json::string("blocked")) &&
    drop.get("verdict") == Some(Json::string("launch_count_changed")) else {
    fail("incorrect repair recommendation on " + target)
  }
  let policy_repair = verify_policy_repair(target)
  let (replay_blocked, replay_passed) = verify_history_replay(target)
  let imported = verify_kubernetes_import(target)
  let observed = verify_observed_kubernetes_jobs(target)
  let assembled = verify_review_documents(target, maintenance)
  let (skip_maintenance, _) = demo(target, "skip-maintenance", 0)
  guard @json.parse(skip_maintenance[:]) is Object(fields) &&
    fields.get("findings") is Some(Array([])) else {
    fail("launch cancellations did not clear the maintenance conflict")
  }
  let (scenarios, _) = invoke_cli(
    target,
    [
      "scenarios", "examples/kubernetes/maintenance.json", "examples/kubernetes/capacity-scenarios.json",
    ],
    2,
  )
  let scenario_json = @json.parse(scenarios[:])
  guard scenario_json is Object(fields) &&
    fields.get("scenarios") is Some(Array([Object(reduced), Object(normal)])) &&
    reduced.get("id") == Some(Json::string("maintenance")) &&
    reduced.get("regression_count") == Some(Json::number(2.0)) &&
    normal.get("id") == Some(Json::string("normal")) &&
    normal.get("verdict") == Some(Json::string("passed")) else {
    fail("incorrect capacity scenario report on " + target)
  }
  [
    before, after, maintenance, existing, gate, summary, duration_blocked, duration_passed,
    proposal, evidence, scenarios, skip_maintenance, repair, replay_blocked, replay_passed,
    imported, assembled, gate_evidence, policy_repair, observed,
  ]
}

///|
async fn verify_policy_repair(target : String) -> String {
  let plan = "examples/kubernetes/repair-existing-overload.json"
  let options = "examples/kubernetes/repair-options.json"
  let policy = "examples/kubernetes/strict-policy.json"
  let (output, _) = invoke_cli(target, ["repair", plan, options, policy], 0)
  guard @json.parse(output[:]) is Object(data) &&
    data.get("schema") ==
    Some(Json::string("batchcontour.launch-repair-report.v2")) &&
    data.get("selected") == Some(Json::string("after-snapshot")) &&
    data.get("options")
    is Some(Array([Object(keep), Object(drop), Object(repaired)])) &&
    keep.get("verdict") == Some(Json::string("blocked")) &&
    keep.get("regression_count") == Some(Json::number(0.0)) &&
    keep.get("policy_violations") is Some(Array([Object(ceiling)])) &&
    ceiling.get("metric") == Some(Json::string("possible_minutes")) &&
    ceiling.get("limit") == Some(Json::number(1.0)) &&
    ceiling.get("actual") == Some(Json::number(2.0)) &&
    drop.get("policy_violations") == Some(Json::null()) &&
    repaired.get("policy_violations") is Some(Array([])) &&
    data.get("proposal") is Some(proposal) else {
    fail("incorrect policy-aware recommendation on " + target)
  }
  let temp = @fs.tmpdir(prefix="batchcontour-policy-repair-")
  defer @fs.rmdir(temp, recursive=true)
  let approved = temp + "/proposal.json"
  @fs.write_file(approved, proposal.stringify())
  ignore(invoke_cli(target, ["gate", approved, policy], 0))
  output
}

///|
async fn verify_gate_evidence_cli(target : String) -> String {
  let plan = "examples/kubernetes/maintenance.json"
  let policy = "examples/kubernetes/lenient-policy.json"
  let (archive, _) = invoke_cli(target, ["archive-gate", plan, policy], 0)
  let (summary, _) = invoke_cli(target, ["gate", plan, policy], 2)
  let (detail, _) = demo(target, "maintenance", 2)
  guard @json.parse(archive[:]) is Object(fields) &&
    fields.get("gate") == Some(@json.parse(summary[:])) &&
    fields.get("report") == Some(@json.parse(detail[:])) else {
    fail("gate archive disagrees with the standalone reports on " + target)
  }
  let temp = @fs.tmpdir(prefix="batchcontour-gate-evidence-")
  defer @fs.rmdir(temp, recursive=true)
  let path = temp + "/evidence.json"
  @fs.write_file(path, archive)
  let (verified, _) = invoke_cli(
    target,
    ["verify-gate-evidence", plan, policy, path],
    0,
  )
  assert_eq(verified, summary)
  let (output, diagnostic) = invoke_cli(
    target,
    [
      "verify-gate-evidence", plan, "examples/kubernetes/strict-policy.json", path,
    ],
    1,
  )
  assert_eq(output, "")
  assert_true(diagnostic.contains("$.policy.resources"))
  archive
}

///|
async fn verify_review_documents(target : String, expected : String) -> String {
  let (assembled, _) = invoke_cli(
    target,
    [
      "assemble", "examples/pull-request/budget.json", "examples/pull-request/baseline.json",
      "examples/pull-request/candidate.json",
    ],
    0,
  )
  let temp = @fs.tmpdir(prefix="batchcontour-documents-")
  defer @fs.rmdir(temp, recursive=true)
  let path = temp + "/review.json"
  @fs.write_file(path, assembled)
  let (result, _) = invoke_cli(target, ["review", path], 2)
  assert_eq(result, expected)
  let (split, _) = invoke_cli(
    target,
    ["split", "examples/kubernetes/maintenance.json"],
    0,
  )
  guard @json.parse(split[:]) is Object(parts) else {
    fail("expected separate parts from a legacy review on " + target)
  }
  let paths = ["budget", "baseline", "candidate"].map(name => {
    temp + "/" + name + ".json"
  })
  for index, name in ["budget", "baseline", "candidate"] {
    guard parts.get(name) is Some(part) else {
      fail("missing review part " + name)
    }
    @fs.write_file(paths[index], part.stringify())
  }
  let (roundtrip, _) = invoke_cli(target, ["assemble", ..paths], 0)
  assert_eq(roundtrip, assembled)
  assembled
}

///|
async fn verify_kubernetes_import(target : String) -> String {
  let (history, _) = invoke_cli(
    target,
    [
      "import-kubernetes", "examples/kubernetes/completed-jobs.json", "candidate",
      "batch-demo", "--min-samples", "2",
    ],
    0,
  )
  guard @json.parse(history[:]) is Object(fields) &&
    fields.get("min_samples") == Some(Json::number(2.0)) else {
    fail("the requested history threshold was lost on " + target)
  }
  for invalid in ["0", "+2", "4097"] {
    let (output, error) = invoke_cli(
      target,
      [
        "import-kubernetes", "examples/kubernetes/completed-jobs.json", "candidate",
        "batch-demo", "--min-samples", invalid,
      ],
      1,
    )
    assert_eq(output, "")
    assert_true(error.contains("--min-samples"))
  }
  let (rejected, diagnostic) = invoke_cli(
    target,
    [
      "import-kubernetes", "examples/kubernetes/completed-jobs.json", "candidate",
      "wrong",
    ],
    1,
  )
  assert_eq(rejected, "")
  assert_true(diagnostic.contains("$.items[0].metadata.namespace"))
  let temp = @fs.tmpdir(prefix="batchcontour-jobs-")
  defer @fs.rmdir(temp, recursive=true)
  let path = temp + "/history.json"
  @fs.write_file(path, history)
  let (replay, _) = invoke_cli(
    target,
    [
      "replay-history", "examples/kubernetes/maintenance.json", path, "candidate",
    ],
    2,
  )
  guard @json.parse(replay[:]) is Object(report) &&
    report.get("overloads") is Some(Array([Object(overload)])) &&
    overload.get("start") == Some(Json::string("2026-11-23T02:02:15Z")) &&
    overload.get("end") == Some(Json::string("2026-11-23T02:02:45Z")) &&
    overload.get("runs")
    is Some(
      Array(
        [
          String("5347d4f2-d38a-46b1-bb46-1a3fcbf470a0"),
          String("6949c51c-d53f-4583-a3be-a74f12fdd70e"),
        ],
      ),
    ) else {
    fail("incorrect replay after Kubernetes import on " + target)
  }
  replay
}

///|
async fn verify_observed_kubernetes_jobs(target : String) -> String {
  let source = "examples/kubernetes/observed-jobs.json"
  let plan = "examples/kubernetes/observed-replay-plan.json"
  let (history, _) = invoke_cli(
    target,
    [
      "import-kubernetes", source, "candidate", "batchcontour-capture", "--min-samples",
      "2",
    ],
    0,
  )
  let temp = @fs.tmpdir(prefix="batchcontour-observed-jobs-")
  defer @fs.rmdir(temp, recursive=true)
  let path = temp + "/history.json"
  @fs.write_file(path, history)
  let (replay, _) = invoke_cli(
    target,
    ["replay-history", plan, path, "candidate"],
    2,
  )
  guard @json.parse(replay[:]) is Object(report) &&
    report.get("coverage") is Some(Array([Object(coverage)])) &&
    coverage.get("job") == Some(Json::string("hello")) &&
    coverage.get("sample_count") == Some(Json::number(2.0)) &&
    coverage.get("insufficient_samples") == Some(Json::boolean(false)) &&
    report.get("overloads") is Some(Array([Object(overload)])) &&
    overload.get("start") == Some(Json::string("2026-11-26T07:37:00Z")) &&
    overload.get("end") == Some(Json::string("2026-11-26T07:37:25Z")) &&
    overload.get("capacity") == Some(Json::number(1.0)) &&
    overload.get("occupied_units") == Some(Json::number(2.0)) &&
    overload.get("runs")
    is Some(
      Array(
        [
          String("39fbfb27-793a-4692-aea6-9bd2978d1402"),
          String("a3cda458-a603-418a-9ca1-313a32a44749"),
        ],
      ),
    ) else {
    fail("incorrect replay of the captured Kubernetes Jobs on " + target)
  }
  let (summary, _) = invoke_cli(
    target,
    ["summarize-replay", plan, path, "candidate"],
    2,
  )
  guard @json.parse(summary[:]) is Object(data) &&
    data.get("resources") is Some(Array([Object(resource)])) &&
    resource.get("overload_seconds") == Some(Json::number(25.0)) &&
    resource.get("peak_excess_units") == Some(Json::number(1.0)) &&
    resource.get("excess_unit_seconds") == Some(Json::number(25.0)) else {
    fail("unexpected shortfall totals for the captured Jobs on " + target)
  }
  let (higher_threshold, _) = invoke_cli(
    target,
    [
      "import-kubernetes", source, "candidate", "batchcontour-capture", "--min-samples",
      "3",
    ],
    0,
  )
  let stricter_path = temp + "/stricter-history.json"
  @fs.write_file(stricter_path, higher_threshold)
  let (insufficient, _) = invoke_cli(
    target,
    ["replay-history", plan, stricter_path, "candidate"],
    2,
  )
  guard @json.parse(insufficient[:]) is Object(report) &&
    report.get("coverage") is Some(Array([Object(coverage)])) &&
    coverage.get("insufficient_samples") == Some(Json::boolean(true)) else {
    fail(
      "expected two observed runs to fall short of the three-sample threshold",
    )
  }
  replay
}

///|
async fn verify_history_replay(target : String) -> (String, String) {
  let plan = "examples/kubernetes/maintenance.json"
  let history = "examples/kubernetes/replay-runs.json"
  let (blocked, _) = invoke_cli(
    target,
    ["replay-history", plan, history, "candidate"],
    2,
  )
  guard @json.parse(blocked[:]) is Object(report) &&
    report.get("overloads") is Some(Array([Object(overload)])) &&
    overload.get("start") == Some(Json::string("2026-11-23T02:02:15Z")) &&
    overload.get("end") == Some(Json::string("2026-11-23T02:02:45Z")) &&
    overload.get("occupied_units") == Some(Json::number(2.0)) &&
    overload.get("capacity") == Some(Json::number(1.0)) &&
    overload.get("runs") is Some(Array([String("early"), String("later")])) else {
    fail("incorrect history replay overload on " + target)
  }
  let (passed, _) = invoke_cli(
    target,
    ["replay-history", plan, history, "baseline"],
    0,
  )
  guard @json.parse(passed[:]) is Object(report) &&
    report.get("overloads") is Some(Array([])) &&
    report.get("verdict") == Some(Json::string("passed")) else {
    fail("incorrect baseline history replay on " + target)
  }
  (blocked, passed)
}

///|
async fn verify_evidence_cli(target : String) -> String {
  let plan = "examples/kubernetes/maintenance.json"
  let (archive, _) = invoke_cli(target, ["archive-review", plan], 0)
  let temp = @fs.tmpdir(prefix="batchcontour-archive-")
  defer @fs.rmdir(temp, recursive=true)
  let good = temp + "/accepted.json"
  let bad = temp + "/tampered.json"
  @fs.write_file(good, archive)
  @fs.write_file(
    bad,
    archive.replace(old="\"verdict\":\"blocked\"", new="\"verdict\":\"passed\""),
  )
  let (empty, error) = invoke_cli(target, ["verify-evidence", plan, bad], 1)
  assert_eq(empty, "")
  assert_true(error.contains("$.report.verdict"))
  let (verified, _) = invoke_cli(target, ["verify-evidence", plan, good], 0)
  let (expected, _) = demo(target, "maintenance", 2)
  assert_eq(verified, expected)
  archive
}

///|
async fn main {
  let args = @env.args()
  let native = match args[1:] {
    ["all"] => true
    ["portable"] => false
    _ => fail("usage: moon run scripts/verify.mbtx portable|all")
  }
  moon(["fmt", "--check"])
  moon(["fmt", "--check", "scripts/verify.mbtx"])
  moon(["check", "--target", "all", "--deny-warn"])
  moon(["info", "--target", "all"])
  let targets = if native {
    ["wasm", "wasm-gc", "js", "native"]
  } else {
    ["wasm", "wasm-gc", "js"]
  }
  for target in targets {
    moon(["test", "--target", target, "--deny-warn"])
  }
  let portable_output = verify_cli("wasm")
  if native {
    assert_eq(verify_cli("native"), portable_output)
  }
}
