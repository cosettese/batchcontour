----
import {
  "moonbitlang/async@0.22.10/fs",
  "moonbitlang/async@0.22.10/shell",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.7/crypto",
}
----

///|
async fn checked(
  program : String,
  arguments : Array[String],
  cwd? : String,
) -> String {
  let result = @shell.Cmd(program, arguments, cwd?).output(timeout_ms=180000)
  if result.exit_code() != 0 {
    fail(
      "\{program} \{arguments.join(" ")} failed\n\{result.stdout()}\n\{result.stderr()}",
    )
  }
  result.stdout() + result.stderr()
}

///|
fn package_path(log : String) -> String raise {
  for line in log.split("\n") {
    let line = line.trim().to_owned()
    if line.has_prefix("Package to ") {
      let path = line[11:].to_owned()
      if path.has_prefix("\\\\?\\") {
        return path[4:].to_owned()
      }
      return path
    }
  }
  fail("moon package did not report an archive path")
}

///|
fn check_members(listing : String) -> Int32 raise {
  let paths = listing
    .replace_all(old="\\", new="/")
    .split("\n")
    .map(line => line.trim().to_owned())
    .filter(path => !path.is_empty())
    .collect()
  let seen : Map[String, Unit] = Map([])
  for path in paths {
    guard !seen.contains(path) else { fail("duplicate archive member " + path) }
    seen[path] = ()
    for segment in path.split("/") {
      guard segment != ".." &&
        segment != "." &&
        segment != ".git" &&
        segment != "_build" &&
        segment != ".mooncakes" &&
        segment != ".moon" &&
        segment != ".github" &&
        segment != "target" &&
        segment != "moon.work" &&
        segment != "integration" else {
        fail("unexpected archive member " + path)
      }
    }
    guard !path.has_prefix("/") &&
      !path.contains(":") &&
      (path == "moon.mod" || !path.has_suffix("/moon.mod")) else {
      fail("unexpected archive member " + path)
    }
  }
  for
    required in [
      "moon.mod", "moon.pkg", "pkg.generated.mbti", "LICENSE", "README.md", "SOURCES.md",
      "CHANGELOG.md", "quickstart.mbt.md", "docs/review-evidence.md", "examples/kubernetes/capacity-scenarios.json",
      "examples/kubernetes/observed-jobs.json", "examples/kubernetes/observed-replay-plan.json",
    ] {
    guard paths.contains(required) else { fail("archive lacks " + required) }
  }
  paths.length()
}

///|
fn release_filename(archive : String) -> String raise {
  let mut filename = ""
  for part in archive.replace_all(old="\\", new="/").split("/") {
    filename = part.to_owned()
  }
  let prefix = "cosettese-batchcontour-"
  guard filename.has_prefix(prefix) && filename.has_suffix(".zip") else {
    fail("unexpected BatchContour package filename: " + filename)
  }
  let version = filename[prefix.length():filename.length() - 4].to_owned()
  if @env.get_env_var("GITHUB_REF_TYPE") == Some("tag") {
    guard @env.get_env_var("GITHUB_REF_NAME") == Some("v" + version) else {
      fail("release tag must match package version " + version)
    }
  }
  "batchcontour-v" + version + "-source.zip"
}

///|
async fn main {
  let (native, output) = match @env.args()[1:] {
    ["portable"] => (false, None)
    ["all"] => (true, None)
    ["portable" | "all" as mode, "--export", directory] =>
      (mode == "all", Some(directory))
    _ =>
      fail(
        "usage: moon run scripts/verify-distribution.mbtx portable|all [--export DIRECTORY]",
      )
  }
  let temp = @fs.tmpdir(prefix="batchcontour-distribution-")
  defer @fs.rmdir(temp, recursive=true)
  let root = @fs.realpath(temp)
  let archive = package_path(
    checked("moon", ["package", "--list", "--target-dir", root + "/producer"]),
  )
  let windows = @env.get_env_var("OS") == Some("Windows_NT")
  let listing = if windows {
    checked("tar", ["-tf", archive])
  } else {
    checked("unzip", ["-Z1", archive])
  }
  let count = check_members(listing)
  let work = root + "/workspace"
  let library = work + "/library"
  let consumer = work + "/consumer"
  @fs.mkdir(work)
  @fs.mkdir(library)
  @fs.mkdir(consumer)
  if windows {
    ignore(checked("tar", ["-xf", archive, "-C", library]))
  } else {
    ignore(checked("unzip", ["-q", archive, "-d", library]))
  }
  if output is Some(_) {
    let paths = ["pkg.generated.mbti", "cmd/batchcontour/pkg.generated.mbti"]
    let interfaces : Array[Bytes] = []
    for path in paths {
      interfaces.push(@fs.read_file(library + "/" + path).binary())
    }
    // Exercise the standalone archive before adding it to a consumer workspace.
    ignore(
      checked(
        "moon",
        ["run", "--deny-warn", "scripts/verify.mbtx", "portable"],
        cwd=library,
      ),
    )
    for index, path in paths {
      assert_eq(@fs.read_file(library + "/" + path).binary(), interfaces[index])
    }
  }
  for file in ["moon.mod", "moon.pkg", "workflow_test.mbt"] {
    @fs.write_file(
      consumer + "/" + file,
      @fs.read_file("integration/consumer/" + file),
    )
  }
  @fs.write_file(work + "/moon.work", "members = [\"library\", \"consumer\"]\n")
  ignore(checked("moon", ["check", "--target", "all", "--deny-warn"], cwd=work))
  let targets = if native {
    ["wasm", "wasm-gc", "js", "native"]
  } else {
    ["wasm", "wasm-gc", "js"]
  }
  for target in targets {
    let result = checked(
      "moon",
      [
        "test", "--package", "cosettese/batchcontour-consumer", "--target", target,
        "--deny-warn",
      ],
      cwd=work,
    )
    guard result.contains("Total tests: 3, passed: 3, failed: 0.") else {
      fail("expected all three consumer tests on " + target + "\n" + result)
    }
    println("Archive consumer \{target}: 3 tests passed")
  }
  let archive_bytes = @fs.read_file(archive).binary()
  let digest = @crypto.sha256(archive_bytes)
  let checksum = @crypto.bytes_to_hex_string(digest)
  if output is Some(directory) {
    let filename = release_filename(archive)
    let destination = directory + "/" + filename
    let manifest = directory + "/SHA256SUMS"
    guard !@fs.exists(destination) && !@fs.exists(manifest) else {
      fail("release archive or checksum already exists in " + directory)
    }
    @fs.write_file(destination, archive_bytes, create_mode=CreateNew)
    @fs.write_file(
      manifest,
      checksum + "  " + filename + "\n",
      create_mode=CreateNew,
    )
    println("Verified the unpacked archive and exported " + filename)
  }
  println("Verified \{count} archive members, SHA-256 \{checksum}")
}
